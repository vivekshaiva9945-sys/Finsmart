# ==============================================================================
# FinSmart - Environment Configuration
# Copy this file to .env and adjust variables as required
# ==============================================================================

# PostgreSQL Host Port (Change to 5433 if 5432 is already used by local PostgreSQL)
DB_PORT=5433

# PostgreSQL Superuser (For DBeaver Admin Connection & Database Migrations)
POSTGRES_DB=finsmart_db
POSTGRES_USER=finsmart_admin
POSTGRES_PASSWORD=change_me_admin

# Application Database Role (Non-Superuser for API Runtime with RLS Enforced)
APP_DB_USER=finsmart_app
APP_DB_PASSWORD=change_me_app

# Security & Authentication
# Min 32 characters for HMAC-SHA256 signature security
JWT_SECRET=super_secret_finsmart_jwt_key_at_least_32_characters_long_2026
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS Allowed Origins (Comma-separated for Next.js web client)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_TENANT=public
